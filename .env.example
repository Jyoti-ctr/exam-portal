# ==========================================
# SECURE EXAM PORTAL - ENVIRONMENT CONFIG
# ==========================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# NEVER commit the real .env file or real passwords to Git!

# Django Core Settings
SECRET_KEY=replace_with_a_secure_random_secret_key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,172.25.16.1

# Database Configuration (MySQL 8.0)
DB_ENGINE=django.db.backends.mysql
DB_NAME=exam_portal_db
DB_USER=exam_app
DB_PASSWORD=your_mysql_password_here
# If running Django inside WSL2 connecting to Windows MySQL:
# Use your WSL default gateway IP (found via `ip route show default | awk '{print $3}'`)
# or '127.0.0.1' if mirrored networking is enabled.
DB_HOST=172.25.16.1
DB_PORT=3306

# CORS Configuration for React (Vite dev server default port 5173)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
